# Groq LLM settings (OpenAI-compatible API)
# Get a key at https://console.groq.com/keys
LLM_API_KEY=your_api_key_here
# Optional alias (used if LLM_API_KEY is empty):
# GROQ_API_KEY=

LLM_MODEL=openai/gpt-oss-20b
LLM_BASE_URL=https://api.groq.com/openai/v1

# Offline / CI: skip Groq and use rating-sorted mock explanations
LLM_DRY_RUN=false

# Recommendation knobs
CANDIDATE_CAP=25
TOP_K=5

# Dataset (Hugging Face)
HF_DATASET_ID=jason1966/absin7_zomato-bangalore-dataset

# Optional: path overrides (relative to project root)
PROCESSED_DATA_PATH=data/processed/restaurants.parquet
RAW_DATA_DIR=data/raw

# Comma-separated browser origins allowed to call the API (Railway).
# Exact URLs plus optional https://*.vercel.app wildcard (handled via regex).
# Leave empty to use localhost defaults + *.vercel.app.
CORS_ORIGINS=http://localhost:3000,https://your-app.vercel.app,https://*.vercel.app
